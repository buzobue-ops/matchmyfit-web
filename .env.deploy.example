# ─── Credenziali FTP Aruba ─────────────────────────────────────────────────
# Copia questo file in .env.deploy e compila con i tuoi dati.
# Il file .env.deploy NON viene mai caricato su GitHub (è nel .gitignore).

FTP_HOST=ftp.zerodb.studio          # oppure l'IP/host FTP di Aruba
FTP_USER=tuo-utente-ftp             # utente FTP Aruba
FTP_PASS=tua-password-ftp           # password FTP Aruba
FTP_PATH=/public_html/matchmyfit/   # percorso sul server (controlla in FileZilla dove è la cartella)
