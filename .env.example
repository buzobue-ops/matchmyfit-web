# ─── URL del backend Railway ──────────────────────────────────────────────
# Dopo aver deployato il backend su Railway, copia qui l'URL che ti dà
# (es. https://matchmyfit-api.up.railway.app)
# Lascia vuoto in sviluppo locale (usa il proxy di Vite)
VITE_API_URL=https://TUO-PROGETTO.up.railway.app

# ─── Google OAuth (Web Application) ─────────────────────────────────────
# 1. console.cloud.google.com → API e servizi → Credenziali
# 2. Crea credenziali → ID client OAuth 2.0 → Applicazione web
# 3. Origini JavaScript autorizzate: https://www.tuodominio.it
# 4. URI di reindirizzamento autorizzati: https://www.tuodominio.it
VITE_GOOGLE_CLIENT_ID=123456789-xxxx.apps.googleusercontent.com

# ─── Apple Sign In (opzionale, configurabile dopo) ───────────────────────
VITE_APPLE_SERVICE_ID=com.matchmyfit.web
VITE_APPLE_REDIRECT_URI=https://www.tuodominio.it
