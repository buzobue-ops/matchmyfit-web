{
  "name": "FitMyCart",
  "short_name": "FitMyCart",
  "description": "Il tuo stylist AI personale — trova la tua taglia perfetta",
  "start_url": "./",
  "display": "standalone",
  "background_color": "#FDFAF5",
  "theme_color": "#111111",
  "orientation": "portrait",
  "lang": "it",
  "icons": [
    {
      "src": "./icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "./icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "share_target": {
    "action": "./",
    "method": "GET",
    "enctype": "application/x-www-form-urlencoded",
    "params": {
      "url":   "shared_url",
      "text":  "shared_text",
      "title": "shared_title"
    }
  }
}
